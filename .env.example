# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real credentials.
# In deployed environments these are set as Vercel environment variables
# (Settings -> Environment Variables), scoped to development / preview / production.

# --- Database -------------------------------------------------------------
# Neon Postgres connection string. Use the POOLED connection (host contains
# `-pooler`) so serverless functions don't exhaust the connection limit.
# Preview deploys get this injected automatically by the Neon-Vercel integration.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth (Better Auth) ---------------------------------------------------
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin of the app. Must match the deployment it runs on.
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (Resend) -------------------------------------------------------
# Transactional email API key. Use a test key locally.
RESEND_API_KEY="re_replace_me"

# Verified sender, e.g. "Creator Marketplace <noreply@your-domain.com>".
EMAIL_FROM=""

# Real sending is OFF unless this is exactly "true" AND both values above are
# set. Three switches, not one, and this is the deliberate one: a preview deploy
# that inherits production secrets still will not mail a real creator, because
# inheriting a key is an accident and setting this is a decision.
# Leave unset everywhere except production.
EMAIL_SEND=""

# Optional. When set, every email is redirected to this address instead of the
# real recipient, with the intended address prefixed to the subject. Use it to
# exercise real Resend delivery in preview without mailing seeded demo users.
EMAIL_TEST_INBOX=""

# --- Scheduled jobs -------------------------------------------------------
# Shared secret required by Vercel Cron endpoints (offer expiry, metric
# reminders) so they can't be triggered by the public internet.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-me-with-a-random-string"
